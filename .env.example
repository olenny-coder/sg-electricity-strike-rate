# ============================================================================
# Strike — environment configuration
# Copy to .env and fill in. Every value here is optional for local development:
# with no .env at all the app runs on a local SQLite file.
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave UNSET for local development: the app uses a SQLite file at data/strike.db
# and needs no provisioning.
#
# SET THIS IN PRODUCTION. Both free hosting targets destroy local files:
#   - Vercel functions have no persistent disk at all.
#   - Render's free web service filesystem is ephemeral (lost on redeploy,
#     restart, and every idle spin-down).
#
# Get a free Postgres from Neon (https://neon.com) and paste the connection
# string. Use the POOLED hostname (it contains "-pooler") for the web server.
#
#   DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# NOTE: Neon requires TLS. Whether the certificate chain is verified is taken
# from sslmode in this string (verify-full => verified). The code strips the
# ssl* query parameters before handing the string to node-postgres, because
# node-postgres silently discards an explicit `ssl` option when they are present.
DATABASE_URL=

# Maximum client-side pool size. Neon's free compute allows ~97 application
# connections, and the pooler sits in front, so a small pool is correct.
PG_POOL_MAX=5

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Render and most PaaS platforms inject PORT. Locally it defaults to 8791.
PORT=8791

# Loopback by default. Set to 0.0.0.0 in a container or PaaS.
# NODE_ENV=production also switches the default to 0.0.0.0.
# HOST=0.0.0.0

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Scheduled ingestion
# ---------------------------------------------------------------------------
# Shared secret for GET /api/cron/sync, used by Vercel Cron. If this is unset
# the endpoint refuses to run (503), so it can never be used as an open trigger
# for unbounded outbound fetching.
#
# Generate one with:  node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated allowlist, needed only when the frontend is hosted separately
# from this API (for example a static frontend on Vercel calling an API on
# Render). Leave unset for single-process deployments — the browser then makes
# same-origin requests and no CORS headers are emitted at all.
#
# ALLOWED_ORIGINS=https://strike.vercel.app,http://localhost:5273
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Frontend build (web/) — Vite reads variables prefixed with VITE_
# ---------------------------------------------------------------------------
# Leave unset when the API serves the client (the normal single-process setup):
# the client then calls /api on its own origin.
#
# Set this for a split deployment where the static frontend and the API live on
# different hosts, then rebuild:  npm run build:web
#
# VITE_API_BASE=https://strike-api.onrender.com
